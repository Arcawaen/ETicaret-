@model IEnumerable<Category>

@{
    foreach (var anaKategori in Model.Where(c => c.ParentId == 0))
    {
        var altKategoriler = Model.Where(c => c.ParentId == anaKategori.Id).ToList();
        if (altKategoriler.Any())
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @anaKategori.Name
                </a>
                <ul class="dropdown-menu m-auto">
                    @foreach (var altKategori in altKategoriler)
                    {
                        <li><a class="dropdown-item" href="/Categories/Index/@altKategori.Id">@altKategori.Name</a></li>
                    }
                </ul>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link text-dark" href="/Categories/Index/@anaKategori.Id">@anaKategori.Name</a>
            </li>
        }
    }
}
