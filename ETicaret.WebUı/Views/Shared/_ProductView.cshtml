@model Product

<div class="col mb-5">
    <div class="card h-100 product-card border-0">
        <!-- Favorite badge-->
        <div class="position-absolute" style="top: 0.75rem; right: 0.75rem; z-index: 10;">
            <form asp-action="Add" asp-controller="Favorites">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <button class="btn btn-transparent favorite-btn p-0 border-0" type="submit" title="Favorilere Ekle">
                    <i class="bi bi-heart"></i>
                </button>
            </form>
        </div>
        <!-- Product image-->
        <div class="overflow-hidden bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
            <a href="/Products/Details/@Model.Id" class="w-100 h-100 d-block text-center">
                <img class="card-img-top h-100 w-auto" style="object-fit: contain; padding: 1rem;" src="~/Img/Products/@Model.Image" alt="@Model.Name">
            </a>
        </div>
        <!-- Product details-->
        <div class="card-body p-4 text-center">
            <!-- Product name-->
            <a href="/Products/Details/@Model.Id" class="text-decoration-none text-dark">
                <h5 class="fw-bolder mb-2 text-truncate" title="@Model.Name">@Model.Name</h5>
            </a>
            <!-- Product price-->
            <div class="product-price mb-3">
                @Model.Price.ToString("c")
            </div>
            <!-- Product actions-->
            <form action="/Cart/Add" method="post">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <button class="btn btn-primary w-100 btn-add-cart d-flex align-items-center justify-content-center gap-2" type="submit">
                    <i class="bi bi-cart-plus"></i> Sepete Ekle
                </button>
            </form>
        </div>
    </div>
</div>