<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <!-- Blocking Theme Script -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem("admin-theme") || "dark";
            if (savedTheme === "light") {
                document.documentElement.classList.add("light-theme");
            } else {
                document.documentElement.classList.remove("light-theme");
            }
        })();
    </script>
    <!-- Google Fonts: Outfit & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- SB Admin CSS (Bootstrap 5.2) -->
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <!-- Premium custom overrides -->
    <style>
        :root {
            --body-bg: #080b11;
            --panel-bg: rgba(17, 25, 40, 0.65);
            --panel-border: rgba(255, 255, 255, 0.08);
            --sidebar-bg: #0b0e14;
            --sidebar-hover: rgba(124, 58, 237, 0.08);
            --sidebar-active: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
            --sidebar-active-glow: rgba(124, 58, 237, 0.4);
            --accent: #7c3aed;
            --accent-gradient: linear-gradient(135deg, #a78bfa 0%, #6366f1 100%);
            --accent-hover: #6d28d9;
            --topbar-bg: rgba(8, 11, 17, 0.8);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --card-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
            --card-hover-shadow: 0 20px 40px -15px rgba(124, 58, 237, 0.25);
            --radius-md: 12px;
            --radius-lg: 16px;
            --input-bg: rgba(255, 255, 255, 0.03);
            --input-border: rgba(255, 255, 255, 0.12);
        }

        html.light-theme {
            --body-bg: #f1f5f9;
            --panel-bg: rgba(255, 255, 255, 0.85);
            --panel-border: rgba(15, 23, 42, 0.08);
            --sidebar-bg: #ffffff;
            --sidebar-hover: rgba(124, 58, 237, 0.06);
            --sidebar-active-glow: rgba(124, 58, 237, 0.2);
            --topbar-bg: rgba(255, 255, 255, 0.85);
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            --card-hover-shadow: 0 20px 25px -5px rgba(124, 58, 237, 0.1), 0 8px 10px -6px rgba(124, 58, 237, 0.1);
            --input-bg: #ffffff;
            --input-border: #cbd5e1;
        }

        body { 
            font-family: 'Inter', sans-serif; 
            background: var(--body-bg); 
            color: var(--text-primary); 
            min-height: 100vh;
            overflow-x: hidden;
            transition: background 0.3s, color 0.3s;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif;
            color: var(--text-primary);
            font-weight: 700;
            transition: color 0.3s;
        }
        
        /* Sidebar */
        #layoutSidenav #layoutSidenav_nav .sb-sidenav { 
            background: var(--sidebar-bg); 
            border-right: 1px solid var(--panel-border); 
            transition: background 0.3s, border-color 0.3s;
        }
        .sb-sidenav-dark .sb-sidenav-menu .nav-link { 
            color: var(--text-secondary); 
            font-size: 0.875rem; 
            font-weight: 500; 
            border-radius: var(--radius-md); 
            margin: 6px 16px; 
            padding: 12px 16px; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            border: 1px solid transparent;
        }
        .sb-sidenav-dark .sb-sidenav-menu .nav-link:hover { 
            color: var(--accent); 
            background: var(--sidebar-hover); 
            border-color: rgba(124, 58, 237, 0.15);
            transform: translateX(6px); 
        }
        .sb-sidenav-dark .sb-sidenav-menu .nav-link.active { 
            color: #fff; 
            background: var(--sidebar-active); 
            border-color: rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 20px -4px var(--sidebar-active-glow); 
        }
        .sb-sidenav-dark .sb-sidenav-menu .sb-sidenav-menu-heading { 
            color: var(--text-muted); 
            font-size: 0.72rem; 
            font-weight: 700; 
            letter-spacing: 0.12em; 
            text-transform: uppercase; 
            padding: 28px 28px 8px; 
        }
        .sb-sidenav-dark .sb-sidenav-footer { 
            background: var(--body-bg); 
            border-top: 1px solid var(--panel-border); 
            color: var(--text-muted); 
            font-size: 0.8rem; 
            padding: 16px 24px;
            transition: background 0.3s, border-color 0.3s;
        }
        .sb-sidenav-brand { 
            background: var(--sidebar-bg); 
            font-family: 'Outfit', sans-serif;
            font-weight: 800; 
            font-size: 1.3rem; 
            letter-spacing: -0.025em; 
            border-bottom: 1px solid var(--panel-border); 
            color: var(--text-primary) !important; 
            padding: 18px 24px;
            transition: background 0.3s, border-color 0.3s, color 0.3s;
        }

        /* Topbar */
        .sb-topnav { 
            background: var(--topbar-bg) !important; 
            backdrop-filter: blur(16px); 
            -webkit-backdrop-filter: blur(16px); 
            border-bottom: 1px solid var(--panel-border); 
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05); 
            transition: background 0.3s, border-color 0.3s;
        }
        .sb-topnav .navbar-brand { 
            font-family: 'Outfit', sans-serif;
            font-weight: 800; 
            color: var(--text-primary) !important; 
            font-size: 1.3rem; 
            letter-spacing: -0.025em; 
            transition: color 0.3s;
        }

        /* Cards */
        .card { 
            border: 1px solid var(--panel-border); 
            border-radius: var(--radius-lg); 
            box-shadow: var(--card-shadow); 
            background: var(--panel-bg); 
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s, border-color 0.3s, box-shadow 0.3s; 
            color: var(--text-primary);
        }
        .card:hover { 
            transform: translateY(-4px); 
            border-color: rgba(124, 58, 237, 0.25);
            box-shadow: var(--card-hover-shadow); 
        }
        .card-header { 
            border-radius: var(--radius-lg) var(--radius-lg) 0 0 !important; 
            background: rgba(255, 255, 255, 0.02); 
            border-bottom: 1px solid var(--panel-border); 
            font-family: 'Outfit', sans-serif;
            font-weight: 700; 
            padding: 1.25rem 1.5rem; 
            color: var(--text-primary); 
            transition: border-color 0.3s, color 0.3s;
        }

        /* Tables */
        .table { 
            border-radius: var(--radius-md); 
            overflow: hidden; 
            border-collapse: separate; 
            border-spacing: 0; 
            background: transparent;
        }
        .table thead th { 
            background: rgba(255, 255, 255, 0.03); 
            color: var(--text-secondary); 
            font-weight: 600; 
            font-size: 0.75rem; 
            text-transform: uppercase; 
            letter-spacing: 0.08em; 
            border: none; 
            padding: 1.1rem 1.25rem; 
            border-bottom: 1px solid var(--panel-border); 
            transition: border-color 0.3s, color 0.3s;
        }
        .table tbody tr { 
            transition: background 0.25s, transform 0.2s; 
        }
        .table tbody tr:hover { 
            background: rgba(124, 58, 237, 0.04) !important; 
        }
        .table td { 
            vertical-align: middle; 
            border-color: var(--panel-border); 
            padding: 1.1rem 1.25rem; 
            color: var(--text-secondary); 
            background: transparent;
            transition: border-color 0.3s, color 0.3s;
        }
        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(255, 255, 255, 0.01);
        }
        .table-striped tbody tr:nth-of-type(even) {
            background-color: transparent;
        }

        /* Buttons */
        .btn-primary { 
            background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%); 
            border: none; 
            font-family: 'Outfit', sans-serif;
            font-weight: 600; 
            border-radius: 10px; 
            padding: 0.6rem 1.5rem; 
            transition: all 0.3s; 
            color: #fff;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
        }
        .btn-primary:hover { 
            background: var(--accent-hover); 
            transform: translateY(-2px); 
            box-shadow: 0 8px 20px -2px rgba(124, 58, 237, 0.4); 
            filter: brightness(1.1);
            color: #fff;
        }
        .btn-info {
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
            border: none;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.6rem 1.5rem;
            transition: all 0.3s;
            color: #fff;
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.2);
        }
        .btn-info:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -2px rgba(6, 182, 212, 0.4);
            filter: brightness(1.1);
            color: #fff;
        }
        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border: none;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.6rem 1.5rem;
            transition: all 0.3s;
            color: #fff;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        }
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -2px rgba(239, 68, 68, 0.4);
            filter: brightness(1.1);
            color: #fff;
        }
        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            border: none;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.6rem 1.5rem;
            transition: all 0.3s;
            color: #fff;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }
        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -2px rgba(16, 185, 129, 0.4);
            filter: brightness(1.1);
            color: #fff;
        }
        .btn-secondary {
            background: linear-gradient(135deg, #64748b 0%, #475569 100%);
            border: none;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.6rem 1.5rem;
            transition: all 0.3s;
            color: #fff;
            box-shadow: 0 4px 12px rgba(100, 116, 139, 0.2);
        }
        .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -2px rgba(100, 116, 139, 0.4);
            filter: brightness(1.1);
            color: #fff;
        }
        .btn-outline-primary {
            border: 1.5px solid #8b5cf6;
            color: #a78bfa;
            background: transparent;
            font-family: 'Outfit', sans-serif;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.6rem 1.5rem;
            transition: all 0.3s;
        }
        .btn-outline-primary:hover {
            background: rgba(139, 92, 246, 0.1);
            color: #c084fc;
            border-color: #c084fc;
            transform: translateY(-2px);
        }
        .btn { 
            border-radius: 10px; 
            font-size: 0.875rem; 
            font-weight: 600; 
            transition: all 0.2s; 
        }
        .btn-sm { 
            border-radius: 8px; 
            font-size: 0.75rem; 
            padding: 0.35rem 0.85rem; 
        }

        /* Badges */
        .badge { 
            border-radius: 8px; 
            font-weight: 600; 
            font-size: 0.75rem; 
            padding: 0.4em 0.7em; 
        }
        .bg-light {
            background-color: rgba(255, 255, 255, 0.08) !important;
            color: var(--text-secondary) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
        }
        html.light-theme .bg-light {
            background-color: rgba(0, 0, 0, 0.04) !important;
            color: var(--text-secondary) !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
        }
        .bg-success {
            background-color: rgba(16, 185, 129, 0.15) !important;
            color: #34d399 !important;
            border: 1px solid rgba(16, 185, 129, 0.3) !important;
        }
        .bg-danger {
            background-color: rgba(239, 68, 68, 0.15) !important;
            color: #f87171 !important;
            border: 1px solid rgba(239, 68, 68, 0.3) !important;
        }
        .bg-warning {
            background-color: rgba(245, 158, 11, 0.15) !important;
            color: #fbbf24 !important;
            border: 1px solid rgba(245, 158, 11, 0.3) !important;
        }
        .bg-info {
            background-color: rgba(6, 182, 212, 0.15) !important;
            color: #22d3ee !important;
            border: 1px solid rgba(6, 182, 212, 0.3) !important;
        }

        /* Page title */
        h1.mt-4 { 
            font-family: 'Outfit', sans-serif;
            font-size: 1.85rem; 
            font-weight: 800; 
            color: var(--text-primary); 
            letter-spacing: -0.03em; 
            margin-bottom: 0.75rem !important; 
            background: linear-gradient(135deg, var(--text-primary) 40%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Forms */
        .form-control, .form-select { 
            background: var(--input-bg) !important; 
            border: 1px solid var(--input-border) !important; 
            border-radius: 10px; 
            font-size: 0.875rem; 
            transition: all 0.3s; 
            padding: 0.65rem 1rem; 
            color: var(--text-primary) !important;
        }
        .form-control::placeholder {
            color: #64748b !important;
        }
        .form-control:focus, .form-select:focus { 
            background: var(--input-bg) !important; 
            border-color: #8b5cf6 !important; 
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.25) !important; 
        }
        .form-label { 
            font-family: 'Outfit', sans-serif;
            font-weight: 600; 
            font-size: 0.875rem; 
            color: var(--text-secondary); 
            margin-bottom: 0.5rem; 
        }

        /* Breadcrumb */
        .breadcrumb { 
            background: rgba(255, 255, 255, 0.02) !important; 
            padding: 10px 16px; 
            border-radius: 8px; 
            border: 1px solid var(--panel-border);
            font-size: 0.8rem; 
            font-weight: 500; 
        }
        html.light-theme .breadcrumb {
            background: #ffffff !important;
        }
        .breadcrumb-item.active {
            color: var(--text-secondary) !important;
        }
        .breadcrumb-item a { 
            color: #a78bfa; 
            text-decoration: none; 
            transition: color 0.2s;
        }
        .breadcrumb-item a:hover { 
            color: #c084fc;
            text-decoration: underline; 
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--body-bg); }
        ::-webkit-scrollbar-thumb { 
            background: rgba(124, 58, 237, 0.15); 
            border-radius: 10px; 
            border: 2px solid var(--body-bg);
        }
        ::-webkit-scrollbar-thumb:hover { background: rgba(124, 58, 237, 0.35); }

        /* Datatables Overrides */
        .datatable-wrapper {
            color: var(--text-secondary);
        }
        .datatable-selector {
            background: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            border-radius: 8px;
            color: var(--text-primary) !important;
            padding: 4px 8px;
        }
        .datatable-input {
            background: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            border-radius: 8px;
            color: var(--text-primary) !important;
            padding: 6px 12px;
        }
        .datatable-pagination a {
            color: var(--text-secondary) !important;
            border-radius: 6px;
            border: 1px solid var(--panel-border) !important;
            background: var(--panel-bg) !important;
            margin: 0 2px;
        }
        .datatable-pagination a:hover {
            background: rgba(124, 58, 237, 0.1) !important;
            border-color: rgba(124, 58, 237, 0.3) !important;
            color: var(--text-primary) !important;
        }
        .datatable-pagination .active a {
            background: #7c3aed !important;
            border-color: rgba(124, 58, 237, 0.3) !important;
            color: #fff !important;
        }
        
        /* Print Styles */
        @@media print {
            body { background: #fff !important; color: #000 !important; }
            .card { background: #fff !important; border: 1px solid #ccc !important; color: #000 !important; box-shadow: none !important; }
            .table thead th { background: #f0f0f0 !important; color: #000 !important; border-bottom: 1px solid #ccc !important; }
            .table td { color: #000 !important; border-bottom: 1px solid #ccc !important; }
            #layoutSidenav_nav, .sb-topnav, .btn-group, .btn { display: none !important; }
            #layoutSidenav_content { margin-left: 0 !important; width: 100% !important; }
        }
    </style>
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>
<body class="sb-nav-fixed">
    <partial name="_UstBar" />
    <div id="layoutSidenav">
        <partial name="_SolMenu" />
        <div id="layoutSidenav_content">
            <main role="main">
                <div class="container-fluid px-4">
                    <h1 class="mt-4">@ViewData["Title"]</h1>
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/admin/js/scripts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

