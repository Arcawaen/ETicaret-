@model IEnumerable<Order>

@{
    ViewData["Title"] = "Siparişler";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h1 class="mt-4 mb-0">Sipariş Yönetimi</h1>
    <a asp-action="Create" class="btn btn-primary" style="box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);">
        <i class="fa-solid fa-plus me-1"></i> Yeni Ekle
    </a>
</div>

<!-- Filtreleme Paneli -->
<div class="card border-0 mb-4 p-3 shadow-sm" style="background: var(--panel-bg); border: 1px solid var(--panel-border) !important;">
    <form method="get" action="/Admin/Orders" id="filterForm">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); font-weight: 600;">Sipariş Durumu</label>
                <select name="state" class="form-select form-select-sm" style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-primary);">
                    <option value="">Tüm Durumlar</option>
                    @foreach (var val in Enum.GetValues<EnumOrderState>())
                    {
                        var isSelected = ViewBag.SelectedState != null && (EnumOrderState)ViewBag.SelectedState == val;
                        var displayAttribute = val.GetType().GetField(val.ToString())
                            ?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                            .FirstOrDefault() as System.ComponentModel.DataAnnotations.DisplayAttribute;
                        var displayName = displayAttribute?.Name ?? val.ToString();
                        
                        if (isSelected)
                        {
                            <option value="@val" selected="selected">@displayName</option>
                        }
                        else
                        {
                            <option value="@val">@displayName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill py-2"><i class="fas fa-filter me-1"></i> Filtrele</button>
                <a href="/Admin/Orders" class="btn btn-outline-secondary btn-sm flex-fill py-2 text-center" style="text-decoration: none;"><i class="fas fa-undo me-1"></i> Temizle</a>
            </div>
        </div>
    </form>
</div>

<table id="datatablesSimple" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AppUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderState)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@Html.DisplayFor(modelItem => item.OrderNumber)</strong>
                </td>
                <td style="font-weight: 600; color: #10b981;">
                    @item.TotalPrice.ToString("c")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AppUser.Name) @Html.DisplayFor(modelItem => item.AppUser.Surname)
                </td>
                <td>
                    @item.OrderDate.ToString("g")
                </td>
                <td>
                    @switch (item.OrderState)
                    {
                        case EnumOrderState.Waiting:
                            <span class="badge bg-warning text-dark" style="font-weight: 500;"><i class="fas fa-clock me-1"></i> Onay Bekliyor</span>
                            break;
                        case EnumOrderState.Approved:
                            <span class="badge bg-info text-dark" style="font-weight: 500;"><i class="fas fa-check-circle me-1"></i> Onaylandı</span>
                            break;
                        case EnumOrderState.Shipped:
                            <span class="badge bg-primary" style="font-weight: 500;"><i class="fas fa-truck me-1"></i> Kargoya Verildi</span>
                            break;
                        case EnumOrderState.Completed:
                            <span class="badge bg-success" style="font-weight: 500;"><i class="fas fa-check-double me-1"></i> Tamamlandı</span>
                            break;
                        case EnumOrderState.Cancelled:
                            <span class="badge bg-danger" style="font-weight: 500;"><i class="fas fa-times-circle me-1"></i> İptal Edildi</span>
                            break;
                        case EnumOrderState.Returned:
                            <span class="badge bg-secondary" style="font-weight: 500;"><i class="fas fa-undo-alt me-1"></i> İade Edildi</span>
                            break;
                        default:
                            <span class="badge bg-light text-dark">@item.OrderState</span>
                            break;
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen"></i></a>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id"><i class="fa-solid fa-magnifying-glass"></i></a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="/admin/js/datatables-simple-demo.js"></script>
}
