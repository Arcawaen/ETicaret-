@model IEnumerable<Product>

@{
    ViewData["Title"] = "Ürünler";
}
<style>
    td.fixed-height { max-width: 180px; height: 22px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h1 class="mt-4 mb-0">Ürün Yönetimi</h1>
    <a asp-action="Create" class="btn btn-primary" style="box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);">
        <i class="fa-solid fa-plus me-1"></i> Yeni Ürün Ekle
    </a>
</div>

<!-- Filtreleme Paneli -->
<div class="card border-0 mb-4 p-3 shadow-sm" style="background: var(--panel-bg); border: 1px solid var(--panel-border) !important;">
    <form method="get" action="/Admin/Products" id="filterForm">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); font-weight: 600;">Kategori</label>
                <select name="categoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories" style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-primary);">
                    <option value="">Tüm Kategoriler</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); font-weight: 600;">Marka</label>
                <select name="brandId" class="form-select form-select-sm" asp-items="ViewBag.Brands" style="background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-primary);">
                    <option value="">Tüm Markalar</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill py-2"><i class="fas fa-filter me-1"></i> Filtrele</button>
                <a href="/Admin/Products" class="btn btn-outline-secondary btn-sm flex-fill py-2 text-center" style="text-decoration: none;"><i class="fas fa-undo me-1"></i> Temizle</a>
            </div>
        </div>
    </form>
</div>

<table id="datatablesSimple" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.CreateDate)</th>
            <th>@Html.DisplayNameFor(model => model.Image)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.ProductCode)</th>
            <th>@Html.DisplayNameFor(model => model.Stock)</th>
            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
            <th>@Html.DisplayNameFor(model => model.IsHome)</th>
            <th>@Html.DisplayNameFor(model => model.Category)</th>
            <th>@Html.DisplayNameFor(model => model.Brand)</th>
            <th>@Html.DisplayNameFor(model => model.OrderNo)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fixed-height">@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@item.CreateDate.ToShortDateString()</td>
                <td><img src="/Img/Products/@item.Image" alt="" height="30" /></td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.ProductCode)</td>
                <td>@Html.DisplayFor(modelItem => item.Stock)</td>
                <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                <td>@Html.DisplayFor(modelItem => item.IsHome)</td>
                <td class="fixed-height">@Html.DisplayFor(modelItem => item.Category.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Brand.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.OrderNo)</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen"></i></a>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id"><i class="fa-solid fa-magnifying-glass"></i></a>
                    <a class="btn btn-sm btn-secondary" asp-controller="ProductImages" asp-action="Index" asp-route-productId="@item.Id"><i class="fa-solid fa-images"></i></a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="fa-solid fa-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="/admin/js/datatables-simple-demo.js"></script>
}
